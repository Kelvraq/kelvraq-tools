{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kelvraq tools",
  "version": "0.3.0",
  "identifier": "tools.kelvraq.files",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "kelvraq tools",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
